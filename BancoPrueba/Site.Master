<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BancoPrueba.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - BancoPrueba</title>
    <link href="~/Content/Banco.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="MainForm" runat="server">
        <header class="site-header">
            <asp:HyperLink ID="lnkBrand" runat="server" NavigateUrl="~/Dashboard.aspx" CssClass="brand">BancoPrueba</asp:HyperLink>
            <span class="header-caption">Sistema de gestion bancaria</span>
        </header>

        <div class="site-shell">
            <aside class="sidebar">
                <p class="sidebar-title">Menu principal</p>
                <nav class="main-nav" aria-label="Navegacion principal">
                    <ul>
                        <li><asp:HyperLink ID="lnkInicio" runat="server" NavigateUrl="~/Dashboard.aspx">Inicio</asp:HyperLink></li>
                        <li><asp:HyperLink ID="lnkCrearUsuario" runat="server" NavigateUrl="~/Pages/CrearUsuario.aspx">Crear Usuario y Cuenta</asp:HyperLink></li>
                        <li><asp:HyperLink ID="lnkActualizarUsuario" runat="server" NavigateUrl="~/Pages/ActualizarUsuario.aspx">Actualizar Estado Usuario</asp:HyperLink></li>
                        <li><asp:HyperLink ID="lnkEstadoCuenta" runat="server" NavigateUrl="~/Pages/EstadoCuenta.aspx">Estado de Cuenta</asp:HyperLink></li>
                        <li><asp:HyperLink ID="lnkTopUsuarios" runat="server" NavigateUrl="~/Pages/TopUsuarios.aspx">Reporte Top Usuarios</asp:HyperLink></li>
                    </ul>
                </nav>
            </aside>

            <main class="content-area">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <footer class="site-footer">
            <span>&copy; <%: DateTime.Now.Year %> BancoPrueba</span>
        </footer>
    </form>
</body>
</html>
